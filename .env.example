# Copy to .env.local and fill in the values.
# All variables marked "required in production" cause a boot failure when
# missing in a production build (see src/lib/env.ts).

# --- Resend (newsletter) -----------------------------------------------------
# Required in production. Without it, subscribe/confirm fail at runtime in dev.
RESEND_API_KEY=

# Optional. Sender identity for confirmation emails.
# Defaults to "Sáblík do Senátu <info@sablikdosenatu.cz>".
RESEND_SEND_FROM_EMAIL=

# Optional. Only needed by scripts/send-coalition-broadcast.mts --create.
# The id of the audience/segment with newsletter contacts
# (Resend dashboard -> Audiences / Segments).
RESEND_SEGMENT_ID=

# --- Token signing -----------------------------------------------------------
# Required in production. HMAC secret for newsletter confirmation tokens.
# Use a long random string, e.g. `openssl rand -base64 48`.
SECRET_PASSPHRASE=

# --- Upstash Redis / Vercel KV ----------------------------------------------
# Required in production. Used for rate limiting (fails closed without it)
# and single-use confirmation token tracking. Optional in development
# (rate limiting is skipped).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Site --------------------------------------------------------------------
# Optional. Absolute origin used in email links and SEO metadata.
# Defaults to https://www.sablikdosenatu.cz.
NEXT_PUBLIC_SITE_URL=

# --- Post-election kill switch -----------------------------------------------
# Optional. Set to "victory" or "loss" to rewrite the whole site to the
# /post-election page (see src/proxy.ts). Leave unset during the campaign.
POST_ELECTION_STATUS=
